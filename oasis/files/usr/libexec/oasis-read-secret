#!/bin/sh
# BusyBox ash restores termios inside its read -s builtin, including interrupted
# reads. Keep terminal ownership in this child so a Lua interruption cannot leave
# echo disabled. Input travels through the pipe only, never argv or a temp file.
trap 'exit 1' HUP INT TERM
exec 3</dev/tty || exit 1
IFS= read -r -s oasis_secret <&3 || exit 1
printf 'ok:%s\n' "$oasis_secret"
unset oasis_secret
