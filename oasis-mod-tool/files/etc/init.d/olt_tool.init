#!/bin/sh /etc/rc.common

# The isolated UCI setup uses rpcd session objects (rpcd starts at 12).
# Run before uhttpd (50) so its timeout defaults are still applied at startup.
START=20

start() {
    ubus -t 10 wait_for session || return 1
    lua /usr/bin/oasis_tool_setup init
}

stop() {
    # This package has no long-running daemon. In particular, package upgrade
    # invokes `stop`; persistent tool choices must survive that operation.
    :
}

restart() {
    lua /usr/bin/oasis_tool_setup refresh
}
