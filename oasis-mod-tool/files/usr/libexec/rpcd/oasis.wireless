#!/usr/bin/env lua

--[[

# Oasis Local Tool (OLT) Server (Lua Script Ver)
 This server script is based on concepts inspired by the Model Context Protocol and Agents.json.
 By leveraging UBUS, an integral part of the OpenWrt ecosystem, the client and server can cooperate
 to allow the AI to access the tools it provides.
 On OpenWrt systems with Oasis and oasis-mod-tool installed, third-party developers can easily expose
 tools to the AI by simply downloading server scripts.

# Rules for defining tools in the local tool server
    - Rule 1. 
        If a tool requires arguments, you must specify a type string for each argument.

        Reference:
        1. string type  ---> "a_string"
        TODO: Investigate data type specifications other than "a_string" and add them here. 

    - Rule 2. 
        The table returned by server.response must be an associative array (key-value pairs).

        Example: 
        server.response({reply = "Hello Tool Client!"})

# Note
 This script is loaded by the `rpcd` module and registered with `ubusd` as a UBUS object.  

# Important
 Please avoid defining global functions in ubus server scripts.
 For AI tool scripts used in Oasis (like this one), write your logic using server.tool.
 If you need to create custom functions, put them inside the call field of the table that’s passed as the second argument to server.tool.
 The same rule applies when using require to load external libraries—make sure to call require inside the call field too.

 About rpcd lua plugin:
 https://github.com/openwrt/luci/blob/37ea60da580490a4d8178134297152661f25151d/applications/luci-app-example/root/usr/libexec/rpcd/luci.example
]]

local server = require("oasis.local.tool.server")

server.tool("get_active_wlan_if_list", {
    tool_desc = "Advanced/diagnostic tool: list the raw wireless interface names on this device (e.g. wlan0, phy0-ap0). Only use this if the user explicitly asks for low-level interface names or Wi-Fi diagnostics. To scan for nearby networks, use wifi_scan with a band instead - it no longer requires an interface name.",
    call = function()
        local util = require("luci.util")
        local iwinfo = util.exec("iwinfo")
        return server.response({result = iwinfo})
    end
})

server.tool("wifi_scan", {
    tool_desc = "Scan for nearby Wi-Fi networks on a given band. The band argument must be exactly 2G or 5G.",
    args_desc = { "Wi-Fi band: exactly 2G for 2.4 GHz or 5G for 5 GHz." },
    args = { band = "a_string"},

    call = function(args)
        local util  = require("luci.util")
        local jsonc = require("luci.jsonc")
        local mkd   = require("oasis.chat.markdown")
        local debug = require("oasis.chat.debug")

        -- Classify a device by its reported frequency (MHz) rather than by
        -- hwmode/htmode, since hwmode alone does not distinguish 5 GHz from
        -- 6 GHz on newer radios.
        local function band_of_frequency(freq)
            freq = tonumber(freq)
            if not freq then
                return nil
            elseif freq >= 2400 and freq <= 2495 then
                return "2G"
            elseif freq >= 5150 and freq <= 5895 then
                return "5G"
            elseif freq >= 5925 and freq <= 7125 then
                return "6G"
            end
            return nil
        end

        local band = args and args.band or nil
        if band ~= "2G" and band ~= "5G" then
            return server.response(
                {
                    error = "band must be exactly 2G or 5G.",
                    request = "Ask the user which Wi-Fi band to scan: 2G for 2.4 GHz or 5G for 5 GHz."
                }
            )
        end

        local wlan_vif = util.ubus("iwinfo", "devices", {})

        if not wlan_vif or not wlan_vif.devices or #wlan_vif.devices == 0 then
            return server.response(
                {
                    error = "No valid wireless interface found.",
                    request = "Instruct the user to enable Wi-Fi. If they are unsure how to do so, encourage them to ask the AI (you) for guidance.",
                }
            )
        end

        -- Build the list of interfaces that actually match the requested
        -- band, using each device's live frequency from iwinfo.
        local candidates = {}
        for _, vif in ipairs(wlan_vif.devices) do
            local info = util.ubus("iwinfo", "info", { device = vif })
            if info and band_of_frequency(info.frequency) == band then
                candidates[#candidates + 1] = { name = vif, mode = info.mode }
            end
        end

        if #candidates == 0 then
            return server.response(
                {
                    error = "No wireless device supports the " .. band .. " band on this router, or Wi-Fi is disabled.",
                    request = "Tell the user that no radio is available for the requested band. Suggest checking Network -> Wireless or trying the other band."
                }
            )
        end

        -- Selection policy when more than one interface matches the band:
        -- prefer the interface currently operating in AP (Master) mode,
        -- since that is the radio actively serving this band on the router.
        -- Otherwise use the first interface iwinfo reported.
        local ifname = candidates[1].name
        for _, c in ipairs(candidates) do
            if c.mode == "Master" then
                ifname = c.name
                break
            end
        end

        local out = util.ubus("iwinfo", "scan", { device = ifname })

        local entry = {}
        entry[#entry + 1] = { "ssid", "bssid", "mode", "band", "channel", "signal" }

        if out and out.results and type(out.results) == "table" then
            for _, r in ipairs(out.results) do
                local idx = #entry + 1
                entry[idx] = {}
                entry[idx][1] = r.ssid
                entry[idx][2] = r.bssid
                entry[idx][3] = r.mode
                entry[idx][4] = r.band
                entry[idx][5] = r.channel or r.primary_channel
                entry[idx][6] = r.signal
            end
        end

        if #entry <= 1 then
                return server.response(
                    {
                        result = "not found",
                        announce = "Wi-Fi may not be enabled. Please check with the user."
                    }
                )
        end

        local markdown_scan_tbl = mkd.table(entry)

        return server.response(
            {
                result = "success",
                scanned_band = band,
                scanned_interface = ifname,
                user_only = markdown_scan_tbl,
                request = "The user has been notified of the WiFi scan results. Please prompt the user to review the scan results.",
            }
        )
    end
})

server.tool("get_wifi_config", {
    tool_desc = "List wireless UCI configuration and runtime status without exposing Wi-Fi credentials.",
    call = function()
        local uci = require("luci.model.uci").cursor()
        local util = require("luci.util")

        local function is_sensitive_option(name)
            local normalized = tostring(name or ""):lower()
            return normalized == "key"
                or normalized:match("^key%d*$") ~= nil
                or normalized == "psk"
                or normalized == "pin"
                or normalized:sub(-4) == "_pin"
                or normalized:find("passphrase", 1, true) ~= nil
                or normalized:find("password", 1, true) ~= nil
                or normalized:find("secret", 1, true) ~= nil
                or normalized:find("private_key", 1, true) ~= nil
        end

        local function sanitize_value(value)
            if type(value) ~= "table" then
                return value
            end

            local sanitized = {}
            for key, child in pairs(value) do
                if is_sensitive_option(key) then
                    sanitized[key] = "[redacted]"
                else
                    sanitized[key] = sanitize_value(child)
                end
            end
            return sanitized
        end

        local function describe_section(section)
            local options = {}
            local redacted_options = {}

            for key, value in pairs(section) do
                if type(key) == "string" and key:sub(1, 1) ~= "." then
                    if is_sensitive_option(key) then
                        redacted_options[#redacted_options + 1] = key
                    else
                        options[key] = sanitize_value(value)
                    end
                end
            end

            table.sort(redacted_options)
            return {
                section = section[".name"],
                options = options,
                credentials_configured = #redacted_options > 0,
                redacted_options = redacted_options
            }
        end

        local devices = {}
        uci:foreach("wireless", "wifi-device", function(section)
            devices[#devices + 1] = describe_section(section)
        end)

        local interfaces = {}
        uci:foreach("wireless", "wifi-iface", function(section)
            interfaces[#interfaces + 1] = describe_section(section)
        end)

        local networks = {}
        uci:foreach("network", "interface", function(section)
            networks[#networks + 1] = section[".name"]
        end)
        table.sort(networks)

        local runtime = util.ubus("network.wireless", "status", {})
        return server.response({
            devices = devices,
            interfaces = interfaces,
            network_interfaces = networks,
            runtime = sanitize_value(runtime or {}),
            note = "Wi-Fi credentials are intentionally omitted from this result."
        })
    end
})

local function open_wifi_form(operation, band)
    return server.response({
        ui_action = {
            type = "wifi_config",
            operation = operation,
            band = band
        },
        user_only = "Open the Wi-Fi settings form to continue.",
        request = "The Oasis WebUI has opened a Wi-Fi settings form. Wait for the user to finish it; do not ask for credentials in chat."
    })
end

local WIFI_FORM_BANDS = {
    ["2g"] = { value = "2G", label = "2.4 GHz" },
    ["5g"] = { value = "5G", label = "5 GHz" }
}

local WIFI_FORM_BANDS_BY_VALUE = {
    ["2G"] = WIFI_FORM_BANDS["2g"],
    ["5G"] = WIFI_FORM_BANDS["5g"]
}

local WIFI_FORM_BAND_ORDER = { "2G", "5G" }

local function configured_wifi_bands()
    local uci = require("luci.model.uci").cursor()
    local found = {}

    uci:foreach("wireless", "wifi-device", function(section)
        local definition = WIFI_FORM_BANDS[tostring(section.band or "")]
        if definition then
            found[definition.value] = true
        elseif section.band == nil or section.band == "" then
            -- Pre-21.02 configurations may identify the radio with hwmode.
            local hwmode = tostring(section.hwmode or "")
            if hwmode == "11b" or hwmode == "11g" then
                found["2G"] = true
            elseif hwmode == "11a" then
                found["5G"] = true
            end
        end
    end)

    local available = {}
    for _, band in ipairs(WIFI_FORM_BAND_ORDER) do
        if found[band] then
            available[#available + 1] = band
        end
    end
    return found, available
end

server.tool("update_wifi_config", {
    tool_desc = "Open the Oasis WebUI form to edit existing Wi-Fi access point settings. This tool takes no arguments and does not modify Wi-Fi settings directly.",
    call = function()
        return open_wifi_form("update")
    end
})

server.tool("delete_wifi_config", {
    tool_desc = "Open the Oasis WebUI form to remove an existing Wi-Fi access point configuration. This tool takes no arguments and does not modify Wi-Fi settings directly.",
    call = function()
        return open_wifi_form("delete")
    end
})

server.tool("add_wifi_config", {
    tool_desc = "Open the Oasis WebUI form to add a Wi-Fi access point configuration. The band argument must be exactly 2G or 5G. The tool returns an error if no radio for the requested band is configured. This tool does not modify Wi-Fi settings directly.",
    args_desc = {
        "Wi-Fi band: exactly 2G for 2.4 GHz or 5G for 5 GHz."
    },
    args = { band = "a_string" },
    call = function(args)
        local band = args and args.band or nil
        local definition = WIFI_FORM_BANDS_BY_VALUE[band]
        if not definition then
            return server.response({
                status = "NG",
                error = "band must be exactly 2G or 5G."
            })
        end

        local configured, available = configured_wifi_bands()
        if not configured[band] then
            return server.response({
                status = "NG",
                error = "No " .. definition.label .. " radio is configured or available on this router.",
                available_bands = available,
                request = "Tell the user that a Wi-Fi configuration cannot be added for the requested band on the currently available radios. Suggest an available band or checking Network → Wireless."
            })
        end

        return open_wifi_form("add", band)
    end
})

server.run(arg)
