#!/usr/bin/env lua

local server = require("oasis.local.tool.server")
local state = require("oasis.local.tool.state")
local jsonc = require("luci.jsonc")

local function response(result)
    return { result = jsonc.stringify(result) }
end

local function cursor()
    return require("luci.model.uci").cursor()
end

server.tool("get_tool_list", {
    tool_desc = "List local tools and their effective enabled state in Auto mode",
    call = function()
        return response(state.list_effective(cursor()))
    end
})

server.tool("set_tool_enabled", {
    tool_desc = "Enable one Auto mode tool until reboot by exact server and name; manual settings are unchanged",
    args_desc = { "Server Name", "Tool Name" },
    args = { server = "a_string", tool = "a_string" },
    call = function(args)
        return response(state.set_auto_enabled(
            cursor(), args.server, args.tool, true))
    end
})

server.tool("set_tool_disabled", {
    tool_desc = "Disable one Auto mode tool until reboot by exact server and name; manual settings are unchanged",
    args_desc = { "Server Name", "Tool Name" },
    args = { server = "a_string", tool = "a_string" },
    call = function(args)
        return response(state.set_auto_enabled(
            cursor(), args.server, args.tool, false))
    end
})

server.run(arg)
