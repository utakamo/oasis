#!/usr/bin/env lua

-- olt: Oasis Local Tool
local common        = require("oasis.common")
local misc          = require("oasis.chat.misc")
local olt_client    = require("oasis.local.tool.client")
local uci_transaction = require("oasis.local.tool.uci_transaction")
local uci           = require("luci.model.uci").cursor()

-- Some Oasis-managed tools may exceed the default 30-second timeout.
-- In those cases, requests can be terminated before the tool finishes,
-- especially when package downloads or installs are involved.
-- Keep the minimum at 60 seconds to avoid premature timeouts.
local MIN_TIMEOUT = 60
-- This marker makes image-build first-boot initialization a one-time migration.
-- Change the suffix whenever package-owned defaults need to be migrated again.
local INITIALIZATION_MARKER =
    "/etc/oasis/.oasis-mod-tool-initialized-1.1.1-r11"
local OWNED_MANIFESTS = {
    "/etc/oasis/tool-manifest.d/lua.oasis.network.json",
    "/etc/oasis/tool-manifest.d/lua.oasis.service.json",
    "/etc/oasis/tool-manifest.d/lua.oasis.system.json",
    "/etc/oasis/tool-manifest.d/lua.oasis.tool.manager.json",
    "/etc/oasis/tool-manifest.d/lua.oasis.wireless.json",
    "/etc/oasis/tool-manifest.d/ucode.oasis_plugin_server.uc.json",
}

local function ensure_min_timeout(
    apply_uci, config, section, option, min_timeout)
    local current_timeout, get_err = apply_uci:get(
        config, section, option)
    if current_timeout == false then
        return nil, "Failed to read " .. config .. "." .. option .. ": "
            .. tostring(get_err or "unknown UCI error")
    end
    current_timeout = current_timeout or ""
    local numeric_timeout = tonumber(current_timeout)
    if (not numeric_timeout) or (numeric_timeout < min_timeout) then
        local set_ok, set_err = apply_uci:set(
            config, section, option, tostring(min_timeout))
        if set_ok ~= true then
            return nil, "Failed to update " .. config .. "." .. option
                .. ": " .. tostring(set_err or "unknown UCI error")
        end
        return true
    end

    return false
end

local function ensure_timeout_config(config, label, values, min_timeout)
    local ok, result = uci_transaction.run({
        cursor = uci,
        config = config,
        label = label,
    }, function(apply_uci)
        local changed = false
        for _, value in ipairs(values) do
            local updated, update_err = ensure_min_timeout(
                apply_uci,
                config,
                value.section,
                value.option,
                min_timeout)
            if updated == nil then
                return false, update_err
            end
            changed = changed or updated
        end
        return true, { changed = changed }
    end)
    if not ok then
        return false, result or ("Failed to update " .. label)
    end
    return true
end

local function ensure_runtime_prerequisites(min_timeout)
    -- Oasis assumes that the common usage is AI interaction via LuCI.
    -- Users chat with AI through the LuCI UI, and the AI may execute tools.
    -- Some tools (e.g., downloading external data over the network) may take time.
    -- To handle such cases, Oasis applies the following timeout settings.
    if misc.check_file_exist("/etc/config/uhttpd") then
        local ok, err = ensure_timeout_config(
            "uhttpd",
            "uHTTPd timeout settings",
            {
                { section = "main", option = "network_timeout" },
                { section = "main", option = "script_timeout" },
            },
            min_timeout)
        if not ok then
            return false, err
        end
    end

    if misc.check_file_exist("/etc/config/rpcd") then
        local ok, err = ensure_timeout_config(
            "rpcd",
            "rpcd timeout settings",
            {
                { section = "@rpcd[0]", option = "timeout" },
            },
            min_timeout)
        if not ok then
            return false, err
        end
    end

    return true
end

local function refresh_local_tool_registry()
    local ok, err = olt_client.update_server_info()
    if not ok then
        return false, err or "Failed to refresh local tool registry"
    end

    return true
end

local function rebuild_manifest_store()
    local ok, err = olt_client.rebuild_manifest_store()
    if not ok then
        return false, err or "Failed to rebuild manifest store"
    end

    return true
end

-- Reconcile only package-owned schemas after restoring a configuration. This
-- deliberately ignores the initialization marker. Restoration preserves
-- support flags as well as the normal Manifest enable/disable safety policy.
local function refresh_package_manifests(preserve_support)
    for _, manifest_path in ipairs(OWNED_MANIFESTS) do
        if not misc.check_file_exist(manifest_path) then
            return false, "Owned manifest is missing: " .. manifest_path
        end
        local applied, apply_err = olt_client.apply_manifest_file(
            manifest_path, {
                preserve_local_tool_support = preserve_support == true,
            })
        if not applied then
            return false, "Failed to apply manifest " .. manifest_path
                .. ": " .. tostring(apply_err or "unknown error")
        end
    end

    return true
end

local function initialize_package_state(force)
    if not force and misc.check_file_exist(INITIALIZATION_MARKER) then
        return true
    end

    local ok, err = olt_client.enable_remote_mcp_support()
    if not ok then
        return false, err or "Failed to enable remote MCP support"
    end
    ok, err = refresh_package_manifests()
    if not ok then
        return false, err
    end

    local marked, marker_err = misc.touch(INITIALIZATION_MARKER)
    if not marked then
        return false, "Failed to record package initialization: "
            .. tostring(marker_err or "unknown error")
    end

    return true
end

local function delete_package_state(remove_marker)
    local ok, result = uci_transaction.run({
        cursor = uci,
        config = common.db.uci.cfg,
        label = "Oasis tool package removal",
    }, function(apply_uci)
        for _, option in ipairs({ "local_tool", "remote_mcp_server" }) do
            local set_ok, set_err = apply_uci:set(
                common.db.uci.cfg,
                common.db.uci.sect.support,
                option,
                "0")
            if set_ok ~= true then
                return false, "Failed to disable " .. option .. ": "
                    .. tostring(set_err or "unknown UCI error")
            end
        end

        local has_tools = false
        local foreach_ok, foreach_result, foreach_err = pcall(
            apply_uci.foreach,
            apply_uci,
            common.db.uci.cfg,
            common.db.uci.sect.tool,
            function()
                has_tools = true
                return false
            end)
        if not foreach_ok
            or (foreach_result == false and foreach_err ~= nil) then
            return false, "Failed to inspect the tool registry: "
                .. tostring(foreach_ok and foreach_err
                    or foreach_result or "unknown UCI error")
        end

        if has_tools then
            local delete_ok, delete_err = apply_uci:delete_all(
                common.db.uci.cfg, common.db.uci.sect.tool)
            if delete_ok ~= true then
                return false, "Failed to remove the tool registry: "
                    .. tostring(delete_err or "unknown UCI error")
            end
        end

        return true, { changed = true }
    end)
    if not ok then
        return false, result or "Failed to remove Oasis tool state"
    end

    if remove_marker and misc.check_file_exist(INITIALIZATION_MARKER) then
        local removed, remove_err = os.remove(INITIALIZATION_MARKER)
        if not removed then
            return false, "Failed to remove package initialization marker: "
                .. tostring(remove_err or "unknown error")
        end
    end

    return true
end

local function run_init()
    local prerequisites_ok, prerequisites_err =
        ensure_runtime_prerequisites(MIN_TIMEOUT)
    if not prerequisites_ok then
        io.stderr:write(tostring(prerequisites_err) .. "\n")
        os.exit(1)
    end

    local ok, err = initialize_package_state()
    if not ok then
        io.stderr:write(err .. "\n")
        os.exit(1)
    end
end

local function run_refresh()
    local prerequisites_ok, prerequisites_err =
        ensure_runtime_prerequisites(MIN_TIMEOUT)
    if not prerequisites_ok then
        io.stderr:write(tostring(prerequisites_err) .. "\n")
        os.exit(1)
    end

    local ok, err = refresh_local_tool_registry()
    if not ok then
        io.stderr:write(err .. "\n")
        os.exit(1)
    end
end

if arg[1] == "init" then
    run_init()
elseif arg[1] == "refresh" then
    run_refresh()
elseif arg[1] == "rebuild-manifest" then
    local ok, err = rebuild_manifest_store()
    if not ok then
        io.stderr:write(err .. "\n")
        os.exit(1)
    end
elseif arg[1] == "enable-remote-mcp-support" then
    local ok, err = olt_client.enable_remote_mcp_support()
    if not ok then
        io.stderr:write(tostring(err or
            "Failed to enable remote MCP support") .. "\n")
        os.exit(1)
    end
elseif arg[1] == "initialize-package" then
    local ok, err = initialize_package_state(arg[2] == "--force")
    if not ok then
        io.stderr:write(tostring(err or
            "Failed to initialize oasis-mod-tool") .. "\n")
        os.exit(1)
    end
elseif arg[1] == "refresh-package-manifests" then
    local ok, err = refresh_package_manifests(true)
    if not ok then
        io.stderr:write(tostring(err or
            "Failed to refresh package-owned tool definitions") .. "\n")
        os.exit(1)
    end
elseif arg[1] == "delete" then
    local ok, err = delete_package_state(arg[2] == "--remove-marker")
    if not ok then
        io.stderr:write(tostring(err or
            "Failed to remove oasis-mod-tool state") .. "\n")
        os.exit(1)
    end
end
