#!/bin/sh
#
# Usage:
#    root@OpenWrt:~# oasis_local_upgrade [mode]
#
# Description:
#   This script removes old versions of Oasis packages, installs new ones,
#   and restarts related services.
#
#   If you pass the keyword "keep-config" as an argument, the script will:
#     1. Backup the current Oasis UCI configuration before removing packages.
#     2. Restore the configuration after the new installation.
#
# Examples:
#   oasis_local_upgrade
#       -> Normal update.
#
#   oasis_local_upgrade keep-config
#       -> Update while preserving the current Oasis configuration.
#

MODE="$1"
PACKAGE_NAMES="
oasis
luci-app-oasis
oasis-mod-tool
oasis-mod-agent
oasis-mod-retired
oasis-tool-edge
oasis-mod-test
oasis-tool-maker
"
LOCAL_PACKAGES=""

die() {
    echo "ERROR: $*" >&2
    exit 1
}

# Keep the managed rpcd login only for the Tool Edge removal in this process.
# The postrm hook checks this private marker against its live ancestors.
EDGE_UPGRADE_DIR="/tmp/oasis-tool-edge-upgrade"
EDGE_UPGRADE_MARKER=""

clear_edge_upgrade_marker() {
    [ -n "$EDGE_UPGRADE_MARKER" ] || return 0
    rm -f "$EDGE_UPGRADE_MARKER" || return 1
    EDGE_UPGRADE_MARKER=""
}

finish_upgrade() {
    edge_exit_status=$?
    trap - 0
    if ! clear_edge_upgrade_marker; then
        echo "ERROR: Failed to clear the Tool Edge upgrade marker." >&2
        [ "$edge_exit_status" -ne 0 ] || edge_exit_status=1
    fi
    exit "$edge_exit_status"
}

trap finish_upgrade 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

edge_private_path() {
    # nixio is an Oasis dependency; stat is optional on OpenWrt.
    lua - "$1" "$2" "$3" <<'LUA'
local ok, fs = pcall(require, "nixio.fs")
if not ok then
    io.stderr:write("ERROR: Could not load Lua/nixio for Tool Edge marker permissions.\n")
    os.exit(1)
end
local metadata = fs.lstat(arg[1])
local valid = metadata and metadata.type == arg[2] and metadata.uid == 0
    and metadata.modedec == tonumber(arg[3])
os.exit(valid and 0 or 1)
LUA
}

create_edge_upgrade_marker() {
    if [ ! -e "$EDGE_UPGRADE_DIR" ] && [ ! -L "$EDGE_UPGRADE_DIR" ]; then
        (umask 077; mkdir "$EDGE_UPGRADE_DIR") 2>/dev/null
    fi
    edge_private_path "$EDGE_UPGRADE_DIR" dir 700 || return 1

    edge_start_time="$(awk '{ sub(/^.*\) /, ""); print $20 }' "/proc/$$/stat")" ||
        return 1
    case "$edge_start_time" in
        ""|*[!0-9]*) return 1 ;;
    esac
    edge_marker_path="$EDGE_UPGRADE_DIR/$$-$edge_start_time"
    # Refuse existing files and symlinks; never overwrite another marker.
    (umask 077; set -C; printf '%s %s oasis-tool-edge\n' "$$" "$edge_start_time" > "$edge_marker_path") ||
        return 1
    EDGE_UPGRADE_MARKER="$edge_marker_path"
    edge_private_path "$EDGE_UPGRADE_MARKER" reg 600
}

remove_edge_for_upgrade() {
    is_installed oasis-tool-edge || return 0
    create_edge_upgrade_marker ||
        die "Failed to create a private Tool Edge upgrade marker."
    opkg remove oasis-tool-edge || die "Failed to remove oasis-tool-edge for upgrade."
    clear_edge_upgrade_marker || die "Failed to clear the Tool Edge upgrade marker."
}

find_latest_ipk() {
    package_name="$1"
    best_file=""
    best_version=""

    for file in ./${package_name}_*_all.ipk; do
        [ -s "$file" ] || continue

        version="${file#./${package_name}_}"
        version="${version%_all.ipk}"
        if [ -z "$best_file" ] || opkg compare-versions "$best_version" '<<' "$version"; then
            best_file="$file"
            best_version="$version"
        fi
    done

    [ -n "$best_file" ] || return 1
    printf '%s\n' "$best_file"
}

collect_local_packages() {
    for package_name in $PACKAGE_NAMES; do
        package_file="$(find_latest_ipk "$package_name")" ||
            die "Missing local IPK package for $package_name."
        LOCAL_PACKAGES="$LOCAL_PACKAGES $package_file"
    done
}

is_installed() {
    opkg status "$1" 2>/dev/null | grep -q "^Status: .* installed"
}

remove_if_installed() {
    if is_installed "$1"; then
        opkg remove "$1"
    fi
}

# Verify every package before removing anything.  Each selected file is
# explicitly prefixed with ./ so opkg never mistakes a missing file for a
# repository package name.
collect_local_packages

# Backup configuration if keep-config mode is enabled
if [ "$MODE" = "keep-config" ]; then
    mkdir -p /tmp/oasis || die "Failed to create backup directory."
    uci export oasis > /tmp/oasis/backup || die "Failed to back up Oasis UCI configuration."
    cp -r /etc/oasis/oasis.conf /tmp/oasis/oasis.conf || die "Failed to back up oasis.conf."
fi

opkg update

# Remove tool plugins
remove_if_installed oasis-tool-test
remove_if_installed oasis-tool-wireguard

# Remove old versions
remove_if_installed luci-i18n-oasis-ja
remove_if_installed oasis-tool-analysis
remove_if_installed oasis-tool-template
remove_if_installed oasis-tool-wireguard
remove_if_installed oasis-tool-test
remove_edge_for_upgrade
remove_if_installed oasis-tool-maker
remove_if_installed luci-app-oasis
remove_if_installed oasis-mod-test
remove_if_installed oasis-mod-agent
remove_if_installed oasis-mod-tool
remove_if_installed oasis-mod-retired
remove_if_installed oasis

# Install the verified local package set.
for package_file in $LOCAL_PACKAGES; do
    opkg install "$package_file" || die "Failed to install $package_file."
done

# Restore configuration if keep-config mode is enabled
if [ "$MODE" = "keep-config" ]; then
    uci -f /tmp/oasis/backup import oasis || die "Failed to restore Oasis UCI configuration."
    cp -r /tmp/oasis/oasis.conf /etc/oasis/oasis.conf || die "Failed to restore oasis.conf."

    # Old backups may predate the explicit RPC account registry.
    /usr/bin/oasis_tool_edge_account migrate ||
        die "Failed to migrate the RPC account registry after configuration restore."

    # Restoring UCI also restores the old tool schemas, after postinst has
    # already marked initialization complete. Reapply package-owned manifests
    # explicitly; a normal init would skip this migration because of its marker.
    /usr/bin/oasis_tool_setup refresh-package-manifests ||
        die "Failed to update package-owned tool definitions after configuration restore."
fi

# Reload RPC objects only after configuration and tool definitions are ready.
if [ -x /etc/init.d/rpcd ]; then
    /etc/init.d/rpcd restart || die "Failed to restart rpcd."
fi
